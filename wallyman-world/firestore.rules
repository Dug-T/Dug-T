rules_version = '2';
// WallyMan World online high scores.
// Anyone can read the table and add a new score; nobody can edit or delete
// one from the game. Scores must look like real game results.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'level', 'ts', 'done'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9 .!-]{1,8}$')
        && request.resource.data.score is int
        && request.resource.data.score > 0 && request.resource.data.score <= 9999999
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 8
        && request.resource.data.ts is int
        && request.resource.data.done is bool;
      allow update, delete: if false;
    }
    // Level Maker courses shared in Course World: anyone can read, upload a
    // valid course, or add exactly one like; nobody can edit or delete.
    match /levels/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'author', 'code', 'likes', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.author is string && request.resource.data.author.size() <= 10
        && request.resource.data.code is string && request.resource.data.code.size() <= 6000
        && request.resource.data.code.matches('^WMW1-[A-Za-z0-9+/]+$')
        && request.resource.data.likes == 0
        && request.resource.data.ts is int;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.likes + 1;
      allow delete: if false;
    }
    // Best Time Attack ghost per level (document L<level>): anyone can read;
    // a new ghost may only replace a slower one.
    match /ghosts/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['li', 'frames', 'name', 'rec'])
        && request.resource.data.frames is int && request.resource.data.frames > 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 10
        && request.resource.data.rec is string && request.resource.data.rec.size() < 400000;
      allow update: if request.resource.data.keys().hasOnly(['li', 'frames', 'name', 'rec'])
        && request.resource.data.frames is int && request.resource.data.frames < resource.data.frames
        && request.resource.data.rec is string && request.resource.data.rec.size() < 400000;
      allow delete: if false;
    }
    // Top 5 best clear times per level (document L<level>), stored as a small JSON list.
    match /leaders/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['li', 'top'])
        && request.resource.data.li is int && request.resource.data.li >= 0 && request.resource.data.li < 64
        && request.resource.data.top is string && request.resource.data.top.size() < 600;
      allow delete: if false;
    }
    // Online co-op rooms: document <5-letter code>-A (host) or -B (guest), each
    // player's live position as a small JSON string. Read or write by id only.
    match /coop/{id} {
      allow get: if id.matches('^[A-Z2-9]{5}-[AB]$');
      allow list: if false;
      allow create, update: if id.matches('^[A-Z2-9]{5}-[AB]$') && request.resource.data.keys().hasOnly(['li', 's', 'ts'])
        && request.resource.data.li is int && request.resource.data.li >= 0 && request.resource.data.li < 400
        && request.resource.data.s is string && request.resource.data.s.size() < 400
        && request.resource.data.ts is int;
      allow delete: if false;
    }
    // Cloud saves (document id = the player's private 10-letter key): read or write by key only.
    match /saves/{id} {
      allow get: if id.matches('^[A-Z2-9]{10}$');
      allow list: if false;
      allow create, update: if id.matches('^[A-Z2-9]{10}$') && request.resource.data.keys().hasOnly(['code', 'ts'])
        && request.resource.data.code is string && request.resource.data.code.size() < 200000
        && request.resource.data.ts is int;
      allow delete: if false;
    }
  }
}
